{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build TryBlazor",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/TryBlazor/TryBlazor.csproj",
                "--configuration",
                "Debug",
                "-p:UseAppHost=false"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}